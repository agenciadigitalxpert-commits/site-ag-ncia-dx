# ---------------------------------------------------------------------------
# Agência Digital Xpert — variáveis de ambiente
# Variáveis NEXT_PUBLIC_* são lidas no BUILD: altere e gere um novo build.
# ---------------------------------------------------------------------------

# Domínio real, sem barra no final. Sem ele, nenhuma URL absoluta de produção é gerada.
NEXT_PUBLIC_SITE_URL=

# "production" libera a indexação (somente com NEXT_PUBLIC_SITE_URL definido).
# Qualquer outro valor (ou vazio) = preview/homologação: noindex + robots.txt bloqueado.
NEXT_PUBLIC_SITE_ENV=preview

# Webhook que recebe os leads do formulário (CRM, n8n, Make, Zapier, RD Station...).
# Somente servidor. Sem ele, o formulário avisa que está em configuração e recusa envios.
LEAD_WEBHOOK_URL=
# Opcional: assina o corpo com HMAC SHA-256 no header X-DX-Signature.
LEAD_WEBHOOK_SECRET=

# Mensuração. O GTM oficial (GTM-MLGX6B67) já está definido no código; use esta variável só para trocar o container.
# Com GTM, configure GA4 e Meta Pixel DENTRO do GTM e deixe os outros vazios.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp real, só dígitos com DDI e DDD (ex.: 5547999999999). Vazio = botão não aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=
